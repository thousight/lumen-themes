{
  "name": "lumen-themes",
  "displayName": "Lumen Themes",
  "description": "A minimal, clean, and high-tech VSCode theme with monochromatic Dark and Warm Paper Light variants.",
  "version": "0.4.3",
  "publisher": "thousight",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "minimalist",
    "monochromatic",
    "dark",
    "light",
    "high-tech",
    "paper"
  ],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#26251e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thousight/lumen-themes"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/theme.test.mjs tests/commit-contract.test.mjs tests/release-notes.test.mjs",
    "test:package": "npm run build && node --test tests/package.test.mjs",
    "test:package:artifact": "node --test tests/package.test.mjs",
    "test:ui": "npm run build && npm run test:ui:artifact",
    "test:ui:artifact": "node scripts/run-ui-tests.mjs",
    "test:compat": "npm run build && node scripts/run-compat-test.mjs",
    "test:all": "npm test && npm run test:package && npm run test:ui:artifact && npm run test:compat",
    "lint:release-commits": "node scripts/lint-release-commits.mjs",
    "checksum": "node scripts/create-checksum.mjs",
    "release": "semantic-release"
  },
  "contributes": {
    "themes": [
      {
        "label": "Lumen Light (Blanc)",
        "uiTheme": "vs",
        "path": "./themes/lumen-blanc.json"
      },
      {
        "label": "Lumen Dark (Noir)",
        "uiTheme": "vs-dark",
        "path": "./themes/lumen-noir.json"
      }
    ]
  },
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "adm-zip": "0.6.0",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "json-dup-key-validator": "1.0.3",
    "mocha": "12.0.0",
    "ovsx": "1.1.1",
    "semantic-release": "25.0.9",
    "vscode-extension-tester": "8.24.0"
  }
}
